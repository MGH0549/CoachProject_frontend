{
  "name": "coaching-platform",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "api:generate": "ng-openapi-gen",
    "start": "ng serve",
    "build": "ng build && node scripts/add-csp.mjs && node scripts/finalize-pwa.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "verify": "npm run typecheck && npm run lint && npm test -- --watch=false && npm run build && npm run e2e",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "e2e": "playwright test",
    "e2e:live": "playwright test --config playwright.live.config.ts",
    "preview": "node scripts/preview.mjs"
  },
  "private": true,
  "packageManager": "npm@11.18.0",
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.6",
    "@angular/router": "^22.2.0",
    "@angular/service-worker": "22.2.6",
    "@angular/ssr": "^22.2.7",
    "@fontsource/cairo": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "luxon": "^3.7.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.0",
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.1",
    "@types/luxon": "^3.7.6",
    "angular-eslint": "^22.6.0",
    "eslint": "^10.15.0",
    "jsdom": "^30.0.0",
    "ng-openapi-gen": "^1.1.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.0.0"
  },
  "type": "module"
}
